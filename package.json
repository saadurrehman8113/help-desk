{
  "name": "help-desk",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": { "concurrently": "^9.2.1", "typescript": "^5.9.3" }
}
